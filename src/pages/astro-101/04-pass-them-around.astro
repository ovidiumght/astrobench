---
import NotebookLayout from "~/layouts/NotebookLayout.astro";
import NotebookPage from "~/components/NotebookPage.astro";
import CodeCell from "~/components/CodeCell.astro";
import LiveCell from "~/components/LiveCell.astro";
import LivePreview from "~/components/LivePreview.astro";
import Challenge, { type ChallengeItem } from "~/components/Challenge.astro";
import Sticky from "~/components/Sticky.astro";
import Prose from "~/components/Prose.astro";
import Marker from "~/components/Marker.astro";
import CodeInline from "~/components/CodeInline.astro";
import { findLesson } from "~/lib/lessons";
import { kw, ident, punct, str, tag, a } from "~/lib/hl";

const lesson = findLesson("04-pass-them-around")!;

const cardCode = `---
const { name, mission } = Astro.props;
---

<div class="card">
    <h1>Hello, {name}!</h1>
    <p>{mission} · ready for orbit.</p>
</div>

<style>
    .card {
        background: #0d0b2e;
        color: #fef3c7;
        padding: 1.5rem;
        border-radius: 12px;
        font-family: system-ui;
    }
</style>`;

const indexCode = `${kw("---")}
${kw("import")} ${ident("Card")} ${kw("from")} ${str("\"~/components/Card.astro\"")}${punct(";")}
${kw("---")}

${punct("&lt;")}${tag("Card")}${a("name", "Mae")}${a("mission", "Endeavour")} ${punct("/&gt;")}
${punct("&lt;")}${tag("Card")}${a("name", "Ovidiu")}${a("mission", "Apollo 42")} ${punct("/&gt;")}
${punct("&lt;")}${tag("Card")}${a("name", "Sergei")}${a("mission", "Soyuz 11")} ${punct("/&gt;")}`;

const challenges: ChallengeItem[] = [
    {
        id: "change-greeting",
        text: 'change the heading text — anything but <code>"Hello, {name}!"</code>',
        check: {
            kind: "all",
            checks: [
                { kind: "sourceMatches", pattern: "<h1[^>]*>[\\s\\S]*?\\{\\s*name\\s*\\}" },
                { kind: "sourceNotMatches", pattern: "<h1[^>]*>\\s*Hello,\\s*\\{\\s*name\\s*\\}!\\s*</h1>" },
            ],
        },
    },
    {
        id: "add-third-prop",
        text: "destructure a third prop (e.g. <code>role</code> or <code>ship</code>) and use it in the template",
        check: {
            kind: "all",
            checks: [
                { kind: "sourceMatches", pattern: "const\\s*\\{[^}]*,[^}]*,[^}]*\\}\\s*=\\s*Astro\\.props" },
                { kind: "sourceMatches", pattern: "\\{\\s*\\w+\\s*\\}" },
            ],
        },
    },
];
---

<NotebookLayout title={lesson.title}>
    <NotebookPage lesson={lesson}>
        <Prose>
            <p>Mission Control sends <Marker>many</Marker> astronauts. We can't hardcode every name inside the card — it'd defeat the point of having a component.</p>
            <p>&nbsp;</p>
            <p>Time for <Marker color="pink">props</Marker>. The card pulls <CodeInline>name</CodeInline> and <CodeInline>mission</CodeInline> from <CodeInline color="red">Astro.props</CodeInline> — any page can pass different values in as HTML attributes.</p>
            <p>&nbsp;</p>
            <p>The preview feeds <CodeInline highlight>name="Mae" mission="Endeavour"</CodeInline> into your Card. Try changing the heading or destructuring an extra prop.</p>
        </Prose>

        <LiveCell
            cellId="ch1-l4"
            file="src/components/Card.astro"
            note="now reusable"
            code={cardCode}
            minHeight={340}
        />

        <Prose class="mt-4">
            <p>And on the page that uses it — pass the values like attributes:</p>
        </Prose>

        <CodeCell file="src/pages/index.astro" code={indexCode} />

        <Prose class="mt-4">
            <p>Three cards. One component. <Marker color="pink">That's the whole trick.</Marker></p>
        </Prose>

        <Fragment slot="pinboard">
            <LivePreview cellId="ch1-l4" caption="page 4 ✦ a Card with props" rotate={2} frameHeight={180} />

            <Challenge cellId="ch1-l4" lessonSlug={lesson.slug} title="try this →" completedMessage="★ props pilot unlocked!" items={challenges} rotate={-1.5} />

            <Sticky color="yellow" rotate={2}>
                <h3 class="font-title text-[26px] text-ink-dark leading-none mb-2">Mental model</h3>
                <p class="font-hand text-[17px] text-ink-dark/90 leading-tight">
                    A component is a <Marker color="pink">cookie cutter</Marker>. Props are the dough. Same shape, different flavors.
                </p>
            </Sticky>

            <Sticky color="blue" rotate={-1.5}>
                <h4 class="font-title text-[22px] leading-tight text-ink-dark mb-1">sandbox note</h4>
                <p class="font-hand text-[16px] text-ink-soft leading-tight">
                    The preview only renders one Card at a time. In a real Astro project the second snippet above would render <Marker>all three</Marker>.
                </p>
            </Sticky>
        </Fragment>
    </NotebookPage>
</NotebookLayout>

<script>
    import { registerCell } from "~/runtime/registry";
    registerCell("ch1-l4", {
        props: { name: "Mae", mission: "Endeavour", role: "commander", ship: "Endeavour" },
    });
</script>
