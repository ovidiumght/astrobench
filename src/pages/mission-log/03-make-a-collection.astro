---
import NotebookLayout from "~/layouts/NotebookLayout.astro";
import NotebookPage from "~/components/NotebookPage.astro";
import CodeCell from "~/components/CodeCell.astro";
import Polaroid from "~/components/Polaroid.astro";
import Sticky from "~/components/Sticky.astro";
import Prose from "~/components/Prose.astro";
import Marker from "~/components/Marker.astro";
import CodeInline from "~/components/CodeInline.astro";
import FileTree from "~/components/FileTree.astro";
import { findLesson } from "~/lib/lessons";
import { kw, ident, punct, expr, str, tag, comment, string, open, close, a } from "~/lib/hl";

const lesson = findLesson("03-make-a-collection")!;

const configCode = `${kw("import")} ${punct("{")} ${ident("defineCollection")}${punct(",")} ${ident("z")} ${punct("}")} ${kw("from")} ${str("\"astro:content\"")}${punct(";")}
${kw("import")} ${punct("{")} ${ident("glob")} ${punct("}")} ${kw("from")} ${str("\"astro/loaders\"")}${punct(";")}

${kw("const")} ${ident("logs")} ${punct("=")} ${ident("defineCollection")}${punct("({")}
&nbsp;&nbsp;${ident("loader")}${punct(":")} ${ident("glob")}${punct("({")} ${ident("pattern")}${punct(":")} ${string("**/*.md")}${punct(",")} ${ident("base")}${punct(":")} ${string("./src/content/logs")} ${punct("})")}${punct(",")}
&nbsp;&nbsp;${ident("schema")}${punct(":")} ${ident("z")}${punct(".")}${ident("object")}${punct("({")}
&nbsp;&nbsp;&nbsp;&nbsp;${ident("title")}${punct(":")} ${ident("z")}${punct(".")}${ident("string")}${punct("(),")}
&nbsp;&nbsp;&nbsp;&nbsp;${ident("date")}${punct(":")} ${ident("z")}${punct(".")}${ident("date")}${punct("(),")}
&nbsp;&nbsp;&nbsp;&nbsp;${ident("author")}${punct(":")} ${ident("z")}${punct(".")}${ident("string")}${punct("(),")}
&nbsp;&nbsp;&nbsp;&nbsp;${ident("hype")}${punct(":")} ${ident("z")}${punct(".")}${ident("number")}${punct("().")}${ident("default")}${punct("(0),")}
&nbsp;&nbsp;${punct("}),")}
${punct("});")}

${kw("export")} ${kw("const")} ${ident("collections")} ${punct("=")} ${punct("{")} ${ident("logs")} ${punct("};")}`;

const indexCode = `${kw("---")}
${kw("import")} ${punct("{")} ${ident("getCollection")} ${punct("}")} ${kw("from")} ${str("\"astro:content\"")}${punct(";")}
${kw("import")} ${ident("Layout")} ${kw("from")} ${str("\"~/layouts/Layout.astro\"")}${punct(";")}

${kw("const")} ${ident("logs")} ${punct("=")} ${punct("(")}${kw("await")} ${ident("getCollection")}${punct("(")}${string("logs")}${punct("))")}
&nbsp;&nbsp;${punct(".")}${ident("sort")}${punct("((")}${ident("a")}${punct(",")} ${ident("b")}${punct(") =&gt;")} ${punct("+")}${ident("b")}${punct(".")}${ident("data")}${punct(".")}${ident("date")} ${punct("-")} ${punct("+")}${ident("a")}${punct(".")}${ident("data")}${punct(".")}${ident("date")}${punct(");")}
${kw("---")}

${punct("&lt;")}${tag("Layout")}${a("title", "Mission Log")}${punct("&gt;")}
&nbsp;&nbsp;${open("h1")}Mission Log${close("h1")}
&nbsp;&nbsp;${open("ul")}
&nbsp;&nbsp;&nbsp;&nbsp;${expr(`${ident("logs")}${punct(".")}${ident("map")}${punct("((")}${ident("log")}${punct(") =&gt;")} ${punct("(")}`)}
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;${open("li")}
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;${open("a", `href={${ident("log")}${punct(".")}${ident("id")}}`)}${expr(`${ident("log")}${punct(".")}${ident("data")}${punct(".")}${ident("title")}`)}${close("a")}
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;${close("li")}
&nbsp;&nbsp;&nbsp;&nbsp;${expr("))")}
&nbsp;&nbsp;${close("ul")}
${punct("&lt;/")}${tag("Layout")}${punct("&gt;")}`;
---

<NotebookLayout title={lesson.title}>
    <NotebookPage lesson={lesson}>
        <Prose>
            <p>One log file works. Six log files? You'd hand-import each one. <Marker>That's silly.</Marker></p>
            <p>&nbsp;</p>
            <p>Content collections turn a folder into a queryable thing. You declare a <Marker color="pink">schema</Marker> with <CodeInline>zod</CodeInline> — and every <CodeInline>.md</CodeInline> in the folder is validated against it at build time.</p>
            <p>&nbsp;</p>
            <p>Typos in your frontmatter? <Marker>Build error.</Marker> Missing a field? Build error. The schema is your safety net.</p>
        </Prose>

        <CodeCell file="src/content.config.ts" note="brand new file" highlightLine={4} code={configCode} />

        <Prose class="mt-4">
            <p>Now your page can pull <Marker>all logs</Marker> with one call:</p>
        </Prose>

        <CodeCell file="src/pages/logs/index.astro" code={indexCode} />

        <Prose class="mt-4">
            <p><CodeInline>log.data</CodeInline> is your typed frontmatter — autocomplete works. <CodeInline>log.id</CodeInline> is the URL-friendly slug. Add a <CodeInline>[...slug].astro</CodeInline> dynamic route to render each one, and you have a real blog.</p>
        </Prose>

        <Fragment slot="pinboard">
            <Polaroid caption="page 3 ✦ ★ unlocked: curator" rotate={2.5}>
                <div class="bg-white border border-ink-dark/15 rounded-md font-[system-ui] px-3 py-3">
                    <h2 class="text-[15px] font-bold mb-2 text-ink-dark">Mission Log</h2>
                    <ul class="space-y-1.5 text-[11px] text-ink-dark/90">
                        <li class="flex items-baseline gap-2 border-b border-ink-dark/8 pb-1">
                            <a class="font-bold text-pen-blue flex-1 truncate">Launch day</a>
                            <span class="text-ink-soft text-[9px] shrink-0">10/14</span>
                        </li>
                        <li class="flex items-baseline gap-2 border-b border-ink-dark/8 pb-1">
                            <a class="font-bold text-pen-blue flex-1 truncate">First EVA</a>
                            <span class="text-ink-soft text-[9px] shrink-0">10/18</span>
                        </li>
                        <li class="flex items-baseline gap-2 border-b border-ink-dark/8 pb-1">
                            <a class="font-bold text-pen-blue flex-1 truncate">Halfway home</a>
                            <span class="text-ink-soft text-[9px] shrink-0">10/22</span>
                        </li>
                        <li class="flex items-baseline gap-2">
                            <a class="font-bold text-pen-blue flex-1 truncate">Splashdown</a>
                            <span class="text-ink-soft text-[9px] shrink-0">10/28</span>
                        </li>
                    </ul>
                </div>
                <p class="mt-2 font-sketch text-sm text-pen-green italic">four files, one query.</p>
            </Polaroid>

            <FileTree
                title="src/content/logs/"
                rotate={-2}
                root={{
                    name: "logs",
                    children: [
                        { name: "launch-day.md" },
                        { name: "first-eva.md", isNew: true },
                        { name: "halfway-home.md", isNew: true },
                        { name: "splashdown.md", isNew: true },
                    ],
                }}
            />

            <Sticky color="yellow" rotate={1.5}>
                <h3 class="font-title text-[26px] text-ink-dark leading-none mb-2">Why a schema?</h3>
                <p class="font-hand text-[17px] text-ink-dark/90 leading-tight">
                    Catch the dumb stuff at build time: <Marker>typo'd field names</Marker>, dates written as <CodeInline>"yesterday"</CodeInline>, missing required fields. You can't ship a broken post.
                </p>
            </Sticky>

            <Sticky color="peach" rotate={-1.5}>
                <div class="flex items-center gap-2 mb-1">
                    <span class="font-sketch text-[13px] text-pen-red uppercase tracking-wider">★ unlocked!</span>
                </div>
                <h4 class="font-title text-[26px] leading-tight text-ink-dark">Curator</h4>
                <p class="font-hand text-[16px] text-ink-soft leading-tight">+90 XP · structured content</p>
            </Sticky>
        </Fragment>
    </NotebookPage>
</NotebookLayout>
