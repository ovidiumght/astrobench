---
import NotebookLayout from "~/layouts/NotebookLayout.astro";
import ConceptPlayground from "~/components/ConceptPlayground.astro";
import { concepts, categoryMeta, categoryOrder, countByCategory } from "~/lib/concepts";
import { findLesson, lessonUrl } from "~/lib/lessons";

const totalCount = concepts.length;
const counts = countByCategory();

/*
 * Per-card visual rhythm. We rotate every Nth card a hair and swap the paper
 * color for variety. Computed from the index so it's deterministic — refresh
 * doesn't shuffle the look. Kept SUBTLE: < 1° rotation, paper-warm vs white.
 * The card visual rhythm is what makes the binder feel hand-assembled vs a
 * spreadsheet.
 */
function cardRhythm(i: number): { rotate: number; bg: string; tape: boolean } {
    const rot = [0, -0.4, 0, 0.5, 0, -0.3, 0.4, 0][i % 8];
    const useWarm = i % 5 === 2;
    const tape = i % 7 === 3;
    return {
        rotate: rot,
        bg: useWarm ? "bg-paper-warm/40" : "bg-white",
        tape,
    };
}
---

<NotebookLayout
    title="Explore"
    description="A binder of Astro concepts, with the smallest possible example of each."
>
    <main class="relative z-10 mx-auto max-w-[1400px] px-4 sm:px-8 pb-14">
        <article class="relative bg-paper-yellow shadow-paper border-2 border-paper-edge rounded-sm overflow-hidden mb-8">
            <span
                class="absolute -top-3 left-[32%] w-32 h-7 bg-tape border-x border-tape-edge -rotate-2 z-10 pointer-events-none"
                style="background-image: linear-gradient(110deg, transparent 0%, rgba(255,255,255,0.25) 50%, transparent 100%);"
            ></span>
            <span class="absolute -top-2 right-[18%] w-24 h-6 bg-marker-pink/55 border-x border-pen-red/25 rotate-3 z-10 pointer-events-none"></span>

            <div class="px-6 sm:px-10 pt-8 sm:pt-10 pb-7">
                <p class="font-sketch text-[12px] uppercase tracking-[0.22em] text-pen-red mb-1">
                    /explore · the binder
                </p>
                <div class="flex items-baseline flex-wrap gap-x-6 gap-y-1 mb-2">
                    <h1 class="font-title text-[42px] sm:text-[52px] leading-none text-ink-dark">
                        Astro concepts
                    </h1>
                    <button
                        type="button"
                        data-explore-surprise
                        class="font-sketch text-sm text-pen-red hover:text-pen-red/70 border border-pen-red/40 hover:border-pen-red/70 rounded-full px-3 py-1 cursor-pointer transition-colors"
                        title="open a random card"
                    >
                        🎲 surprise me
                    </button>
                </div>
                <p class="font-hand text-base sm:text-lg text-ink-soft italic max-w-[620px] mb-5 sm:mb-6">
                    Every idea from the curriculum, with the smallest example that fits. Search, filter, jump straight to the lesson when you want depth.
                </p>

                <div class="relative max-w-[520px]">
                    <input
                        type="text"
                        data-explore-search
                        placeholder="search · getStaticPaths, slot, client:visible…"
                        autocomplete="off"
                        spellcheck="false"
                        class="w-full font-type text-[15px] sm:text-[16px] bg-white border-2 border-ink-dark/15 px-4 py-2.5 pr-10 rounded-md outline-none focus:border-pen-red/50 focus:bg-white shadow-sm"
                    />
                    <button
                        type="button"
                        data-explore-clear
                        aria-label="clear search"
                        class="hidden absolute right-2 top-1/2 -translate-y-1/2 font-sketch text-sm text-ink-soft hover:text-pen-red px-2 py-1 cursor-pointer"
                    >
                        ✕
                    </button>
                </div>

                <div class="mt-5 flex flex-wrap gap-2" data-explore-cats>
                    <button
                        type="button"
                        data-cat="all"
                        data-active="true"
                        class="cat-pill flex items-center gap-2 font-sketch text-[14px] px-3 py-1 rounded-full border-2 cursor-pointer transition-colors"
                    >
                        <span class="inline-block h-2 w-2 rounded-full bg-ink-dark/60"></span>
                        all
                        <span class="opacity-60">({totalCount})</span>
                    </button>
                    {
                        categoryOrder.map((c) => (
                            <button
                                type="button"
                                data-cat={c}
                                class="cat-pill flex items-center gap-2 font-sketch text-[14px] px-3 py-1 rounded-full border-2 cursor-pointer transition-colors"
                            >
                                <span class:list={["inline-block h-2 w-2 rounded-full", categoryMeta[c].dot]} />
                                {categoryMeta[c].label}
                                <span class="opacity-60">({counts[c]})</span>
                            </button>
                        ))
                    }
                </div>

                <p class="mt-4 font-sketch text-sm text-ink-soft/80">
                    <span class="text-pen-red">tip:</span>
                    press <kbd class="font-type text-[12px] bg-white border border-ink-dark/15 rounded px-1.5 py-0.5 mx-0.5">⌘K</kbd> from anywhere to fuzzy-find a concept · cards with <span class="text-pen-red">▶</span> open a live editor
                </p>
            </div>
        </article>

        <div
            data-explore-results
            class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-5"
        >
            {
                concepts.map((concept, i) => {
                    const lesson = concept.lessonSlug ? findLesson(concept.lessonSlug) : null;
                    const meta = categoryMeta[concept.category];
                    const rhythm = cardRhythm(i);
                    const playable = !!concept.play;
                    return (
                        <article
                            data-concept-card
                            data-concept-id={concept.id}
                            data-concept-category={concept.category}
                            data-concept-title={concept.title.toLowerCase()}
                            data-concept-blurb={concept.blurb.toLowerCase()}
                            data-concept-tags={concept.tags.join(" ").toLowerCase()}
                            data-concept-lesson={concept.lessonSlug ?? ""}
                            data-concept-playable={playable ? "true" : "false"}
                            id={concept.id}
                            style={`transform:rotate(${rhythm.rotate}deg)`}
                            class:list={[
                                "group relative border-2 border-ink-dark/12 rounded-sm shadow-paper p-4 flex flex-col scroll-mt-28 transition-transform hover:rotate-0 hover:-translate-y-0.5",
                                rhythm.bg,
                            ]}
                        >
                            {rhythm.tape && (
                                <span
                                    class="absolute -top-2 left-6 w-14 h-4 bg-tape border-x border-tape-edge -rotate-3 pointer-events-none"
                                    aria-hidden="true"
                                />
                            )}
                            <span
                                data-concept-seen
                                class="hidden absolute top-2 right-2 font-sketch text-[11px] text-pen-green/90"
                                title="you've cleared the lesson that introduces this"
                            >
                                ★ seen
                            </span>
                            <span
                                data-concept-ahead
                                class="hidden absolute top-2 right-2 font-sketch text-[11px] text-ink-soft/60 italic"
                                title="you'll meet this in an upcoming lesson"
                            >
                                ↗ later
                            </span>

                            <div class="flex items-center gap-2 mb-1">
                                <span class:list={["inline-block h-2 w-2 rounded-full", meta.dot]} />
                                <span class="font-sketch text-[11px] uppercase tracking-[0.18em] text-ink-soft">
                                    {meta.label}
                                </span>
                                {playable && (
                                    <button
                                        type="button"
                                        data-concept-play
                                        class="ml-auto font-sketch text-[12px] text-pen-red hover:text-white hover:bg-pen-red border border-pen-red/50 rounded-full px-2 py-0.5 cursor-pointer transition-colors"
                                        title="open in a live editor"
                                    >
                                        ▶ play
                                    </button>
                                )}
                            </div>
                            <h2
                                data-concept-title-el
                                class="font-title text-[24px] text-ink-dark leading-tight mb-1"
                            >
                                {concept.title}
                            </h2>
                            <p
                                data-concept-blurb-el
                                class="font-sketch text-[14px] text-ink-soft/85 leading-snug mb-3"
                            >
                                {concept.blurb}
                            </p>
                            <pre class="bg-paper-warm/45 border border-ink-dark/10 p-2.5 rounded font-type text-[11.5px] text-ink-navy overflow-x-auto paper-scrollbar leading-snug whitespace-pre flex-1"><code>{concept.code}</code></pre>

                            {concept.tags.length > 0 && (
                                <div class="mt-3 flex flex-wrap gap-1.5">
                                    {concept.tags.map((tag) => (
                                        <button
                                            type="button"
                                            data-concept-tag={tag}
                                            class="font-type text-[11px] text-ink-soft/80 hover:text-pen-red bg-paper-warm/40 hover:bg-paper-warm border border-ink-dark/10 hover:border-pen-red/40 rounded px-1.5 py-0.5 cursor-pointer transition-colors"
                                        >
                                            #{tag}
                                        </button>
                                    ))}
                                </div>
                            )}

                            {lesson ? (
                                <a
                                    href={lessonUrl(lesson)}
                                    class="mt-3 self-start font-sketch text-[13px] text-pen-red/85 hover:text-pen-red inline-flex items-center gap-1 cursor-pointer"
                                >
                                    → Lesson {lesson.step} · {lesson.title}
                                </a>
                            ) : (
                                <span class="mt-3 font-sketch text-[12px] text-ink-soft/60 italic">
                                    no lesson — just a useful trick
                                </span>
                            )}
                        </article>
                    );
                })
            }
            <article
                data-explore-empty
                class="hidden sm:col-span-2 xl:col-span-3 bg-paper-warm/60 border-2 border-dashed border-ink-dark/15 rounded-sm p-8 text-center"
            >
                <p class="font-title text-[28px] text-ink-dark/70 mb-1">no matches</p>
                <p class="font-sketch text-base text-ink-soft italic">
                    try a different word, or clear the search.
                </p>
            </article>
        </div>

        <p class="mt-6 font-sketch text-base text-ink-soft" data-explore-meta>
            {totalCount} concepts in the binder.
        </p>
    </main>

    <ConceptPlayground />
</NotebookLayout>

<style>
    /*
     * Category pill states. Tailwind's class:list helpers handle the active
     * dot/text changes via data-active in the script — these rules just style
     * the base and the active state consistently across pills.
     */
    .cat-pill {
        background: rgba(255, 255, 255, 0.8);
        border-color: rgba(40, 30, 50, 0.12);
        color: rgba(60, 50, 70, 0.75);
    }
    .cat-pill:hover {
        color: rgba(40, 30, 50, 1);
        border-color: rgba(40, 30, 50, 0.25);
    }
    .cat-pill[data-active="true"] {
        background: #fff;
        border-color: rgba(200, 69, 69, 0.55);
        color: #2a2030;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
    }

    /* Brief flash when a card is deep-linked via #hash. */
    @keyframes concept-flash {
        0%   { box-shadow: 0 0 0 0 rgba(200, 69, 69, 0.55); }
        40%  { box-shadow: 0 0 0 6px rgba(200, 69, 69, 0.0); }
        100% { box-shadow: 0 0 0 0 rgba(200, 69, 69, 0); }
    }
    [data-concept-card][data-flash="true"] {
        animation: concept-flash 1.6s ease-out;
    }

    /* Highlighted substring inside title/blurb during search. */
    :global([data-concept-card] mark.explore-hl) {
        background: rgba(252, 211, 77, 0.55);
        color: inherit;
        padding: 0 1px;
        border-radius: 2px;
    }

    /* Visually de-emphasize cards from lessons the user hasn't reached yet. */
    [data-concept-card][data-ahead-state="true"] {
        opacity: 0.78;
    }
</style>

<script>
    import { getProgress, onProgressChange } from "~/scripts/progress";
    import { chapters } from "~/lib/lessons";

    /*
     * Build a flat "global order" for every lesson across chapters. Used to
     * decide if a concept's lesson is BEHIND the user's frontier (★ seen),
     * AT the frontier, or AHEAD (↗ later). The frontier is the max global
     * index of any completed lesson.
     */
    const lessonOrder = new Map<string, number>();
    let gi = 0;
    for (const ch of chapters) {
        for (const l of ch.lessons) {
            lessonOrder.set(l.slug, gi++);
        }
    }

    const root = document.querySelector<HTMLElement>("[data-explore-results]");
    const input = document.querySelector<HTMLInputElement>("[data-explore-search]");
    const clearBtn = document.querySelector<HTMLButtonElement>("[data-explore-clear]");
    const meta = document.querySelector<HTMLElement>("[data-explore-meta]");
    const empty = document.querySelector<HTMLElement>("[data-explore-empty]");
    const cats = document.querySelector<HTMLElement>("[data-explore-cats]");
    const surpriseBtn = document.querySelector<HTMLButtonElement>("[data-explore-surprise]");

    if (root && input && meta && empty && cats && clearBtn && surpriseBtn) {
        const cards = Array.from(root.querySelectorAll<HTMLElement>("[data-concept-card]"));
        const total = cards.length;

        /* ---------------------------------- initial state from URL ---- */

        const params = new URLSearchParams(window.location.search);
        let activeCat = params.get("cat") || "all";
        let activeQ = params.get("q") || "";
        input.value = activeQ;

        const initialCatBtn = cats.querySelector<HTMLElement>(`[data-cat="${CSS.escape(activeCat)}"]`);
        if (initialCatBtn) {
            for (const b of cats.querySelectorAll<HTMLElement>("[data-cat]")) b.removeAttribute("data-active");
            initialCatBtn.setAttribute("data-active", "true");
        } else {
            activeCat = "all";
        }

        /* --------------------------------------- URL state sync ------- */

        function syncUrl(push: boolean) {
            const next = new URLSearchParams();
            if (activeCat !== "all") next.set("cat", activeCat);
            if (activeQ.trim()) next.set("q", activeQ.trim());
            const qs = next.toString();
            const url = qs ? `${window.location.pathname}?${qs}${window.location.hash}` : `${window.location.pathname}${window.location.hash}`;
            const fn = push ? "pushState" : "replaceState";
            window.history[fn]({ q: activeQ, cat: activeCat }, "", url);
        }

        window.addEventListener("popstate", () => {
            const p = new URLSearchParams(window.location.search);
            activeCat = p.get("cat") || "all";
            activeQ = p.get("q") || "";
            input.value = activeQ;
            for (const b of cats.querySelectorAll<HTMLElement>("[data-cat]")) {
                b.toggleAttribute("data-active", b.getAttribute("data-cat") === activeCat);
            }
            applyFilter(false);
        });

        /* --------------------------------------- search highlight ----- */

        const escape = (s: string) =>
            s.replace(/[&<>"']/g, (c) =>
                c === "&" ? "&amp;" : c === "<" ? "&lt;" : c === ">" ? "&gt;" : c === '"' ? "&quot;" : "&#39;",
            );

        function highlight(text: string, q: string): string {
            if (!q) return escape(text);
            const lower = text.toLowerCase();
            const lowerQ = q.toLowerCase();
            let out = "";
            let i = 0;
            while (i <= text.length) {
                const idx = lower.indexOf(lowerQ, i);
                if (idx === -1) {
                    out += escape(text.slice(i));
                    break;
                }
                out += escape(text.slice(i, idx));
                out += `<mark class="explore-hl">${escape(text.slice(idx, idx + q.length))}</mark>`;
                i = idx + q.length;
            }
            return out;
        }

        function setPlain(el: HTMLElement | null, text: string) {
            if (el) el.textContent = text;
        }

        /* --------------------------------- filter + highlight pipeline */

        function applyFilter(updateHistory = true) {
            const q = activeQ.trim().toLowerCase();
            let visible = 0;

            for (const card of cards) {
                const cat = card.getAttribute("data-concept-category") || "";
                const title = card.getAttribute("data-concept-title") || "";
                const blurb = card.getAttribute("data-concept-blurb") || "";
                const tags = card.getAttribute("data-concept-tags") || "";

                const catOk = activeCat === "all" || activeCat === cat;
                const qOk =
                    q === "" ||
                    title.includes(q) ||
                    blurb.includes(q) ||
                    tags.includes(q);

                const show = catOk && qOk;
                card.style.display = show ? "" : "none";
                if (show) visible += 1;

                const titleEl = card.querySelector<HTMLElement>("[data-concept-title-el]");
                const blurbEl = card.querySelector<HTMLElement>("[data-concept-blurb-el]");
                if (show && q && (title.includes(q) || blurb.includes(q))) {
                    if (titleEl) titleEl.innerHTML = highlight(titleEl.textContent || "", activeQ.trim());
                    if (blurbEl) blurbEl.innerHTML = highlight(blurbEl.textContent || "", activeQ.trim());
                } else {
                    if (titleEl) setPlain(titleEl, titleEl.textContent || "");
                    if (blurbEl) setPlain(blurbEl, blurbEl.textContent || "");
                }
            }

            empty.classList.toggle("hidden", visible !== 0);
            clearBtn.classList.toggle("hidden", activeQ === "");

            if (activeQ === "" && activeCat === "all") {
                meta.textContent = `${total} concepts in the binder.`;
            } else if (visible === 0) {
                meta.textContent = `0 of ${total} match.`;
            } else if (visible === total) {
                meta.textContent = `${total} concepts.`;
            } else {
                meta.textContent = `${visible} of ${total} match.`;
            }

            if (updateHistory) syncUrl(false);
        }

        /* ------------------------------------------- search input ----- */

        input.addEventListener("input", () => {
            activeQ = input.value;
            applyFilter();
        });

        clearBtn.addEventListener("click", () => {
            input.value = "";
            activeQ = "";
            applyFilter();
            input.focus();
        });

        /* ------------------------------------------- category pills --- */

        cats.addEventListener("click", (e) => {
            const target = e.target as HTMLElement | null;
            const btn = target?.closest<HTMLButtonElement>("[data-cat]");
            if (!btn) return;
            const next = btn.getAttribute("data-cat") || "all";
            activeCat = next;
            for (const b of cats.querySelectorAll<HTMLElement>("[data-cat]")) {
                if (b === btn) b.setAttribute("data-active", "true");
                else b.removeAttribute("data-active");
            }
            applyFilter();
        });

        /* ------------------------------------------- tag chip clicks - */

        root.addEventListener("click", (e) => {
            const target = e.target as HTMLElement | null;
            const tagBtn = target?.closest<HTMLButtonElement>("[data-concept-tag]");
            if (!tagBtn) return;
            const tag = tagBtn.getAttribute("data-concept-tag") || "";
            if (!tag) return;
            input.value = tag;
            activeQ = tag;
            applyFilter();
            input.focus();
            input.scrollIntoView({ behavior: "smooth", block: "start" });
        });

        /* ----------------------------------------- surprise button --- */

        surpriseBtn.addEventListener("click", () => {
            const visibleCards = cards.filter((c) => c.style.display !== "none");
            const pool = visibleCards.length > 0 ? visibleCards : cards;
            const target = pool[Math.floor(Math.random() * pool.length)];
            if (!target) return;
            const id = target.getAttribute("data-concept-id");
            if (id) {
                window.location.hash = `#${id}`;
            }
            target.scrollIntoView({ behavior: "smooth", block: "center" });
            target.setAttribute("data-flash", "true");
            setTimeout(() => target.removeAttribute("data-flash"), 1700);
        });

        /* ---------------------------------- deep-link flash on hash --- */

        function flashFromHash() {
            const id = window.location.hash.replace(/^#/, "");
            if (!id) return;
            const card = root!.querySelector<HTMLElement>(`[data-concept-id="${CSS.escape(id)}"]`);
            if (!card) return;
            card.scrollIntoView({ behavior: "smooth", block: "center" });
            card.setAttribute("data-flash", "true");
            setTimeout(() => card.removeAttribute("data-flash"), 1700);
        }
        window.addEventListener("hashchange", flashFromHash);

        /* -------------------------------- progress decoration --------- */

        function paintProgress() {
            const state = getProgress();
            const completed = new Set(state.completed);
            const frontier =
                state.completed.reduce((max, slug) => {
                    const idx = lessonOrder.get(slug);
                    return idx != null && idx > max ? idx : max;
                }, -1);

            for (const card of cards) {
                const slug = card.getAttribute("data-concept-lesson") || "";
                const seen = card.querySelector<HTMLElement>("[data-concept-seen]");
                const ahead = card.querySelector<HTMLElement>("[data-concept-ahead]");
                if (!slug || !seen || !ahead) continue;

                const idx = lessonOrder.get(slug);
                const isSeen = completed.has(slug);
                /*
                 * "ahead" = strictly later than the user's furthest completion
                 * AND not yet completed. We also only paint it once the user
                 * has made *some* progress, otherwise every card on first
                 * visit looks shadowed.
                 */
                const isAhead =
                    !isSeen && frontier >= 0 && idx != null && idx > frontier;

                seen.classList.toggle("hidden", !isSeen);
                ahead.classList.toggle("hidden", !isAhead);
                card.toggleAttribute("data-ahead-state", isAhead);
            }
        }

        paintProgress();
        onProgressChange(paintProgress);

        applyFilter(false);
        flashFromHash();
    }
</script>
