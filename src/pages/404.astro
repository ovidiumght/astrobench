---
import NotebookLayout from "~/layouts/NotebookLayout.astro";
import Sticky from "~/components/Sticky.astro";
import Marker from "~/components/Marker.astro";
import CodeInline from "~/components/CodeInline.astro";
---

<NotebookLayout
    title="404"
    description="Nothing under this filename. Try the binder, the home page, or ⌘K."
>
    <main class="relative z-10 mx-auto max-w-[1500px] px-8 pb-14">
        <div class="grid grid-cols-1 lg:grid-cols-[1.6fr_1fr] gap-10">
            <article
                class="relative bg-paper-yellow shadow-paper border-2 border-paper-edge rounded-sm overflow-hidden"
            >
                <span
                    class="absolute -top-3 left-[28%] w-32 h-7 bg-tape border-x border-tape-edge -rotate-2 z-10 pointer-events-none"
                    style="background-image: linear-gradient(110deg, transparent 0%, rgba(255,255,255,0.25) 50%, transparent 100%);"
                ></span>
                <span
                    class="absolute -top-2 right-[20%] w-24 h-6 bg-marker-pink/55 border-x border-pen-red/25 rotate-3 z-10 pointer-events-none"
                ></span>

                <div class="absolute top-3 left-0 right-0 flex justify-center gap-32 pointer-events-none">
                    <span
                        class="block h-4 w-4 rounded-full bg-desk-dark/80"
                        style="box-shadow: inset 0 2px 2px rgba(0,0,0,0.25);"></span>
                    <span
                        class="block h-4 w-4 rounded-full bg-desk-dark/80"
                        style="box-shadow: inset 0 2px 2px rgba(0,0,0,0.25);"></span>
                    <span
                        class="block h-4 w-4 rounded-full bg-desk-dark/80"
                        style="box-shadow: inset 0 2px 2px rgba(0,0,0,0.25);"></span>
                </div>

                <div class="relative pl-24 pr-12 pt-16 pb-14 ruled">
                    <div class="absolute left-[68px] top-0 bottom-0 w-px bg-pen-red/40"></div>
                    <div class="absolute left-[72px] top-0 bottom-0 w-px bg-pen-red/40"></div>

                    <div
                        class="absolute -left-2 top-12 -rotate-[10deg] font-sketch text-pen-red text-lg leading-tight w-20 text-center pointer-events-none"
                    >
                        <div class="text-xs uppercase tracking-wider">page</div>
                        <div class="font-title text-3xl leading-none">404</div>
                    </div>

                    <h1 class="font-title text-[58px] leading-[0.9] text-ink-dark mb-3">
                        <Marker color="yellow">404</Marker> · nothing under that filename
                    </h1>

                    <p class="font-hand text-[20px] leading-[32px] text-ink-dark/90 max-w-[600px] mb-3">
                        Astro built every page from files in <CodeInline>src/pages/</CodeInline>. There wasn't one matching this URL — so the server is doing the polite thing and admitting it.
                    </p>

                    <p class="font-sketch text-lg text-ink-soft italic max-w-[560px] mb-10">
                        no shame. URLs typo themselves all the time.
                    </p>

                    <div class="flex flex-wrap items-center gap-x-5 gap-y-3 mb-4">
                        <a
                            href="/"
                            class="font-title text-[22px] text-pen-red hover:text-pen-red/70 underline decoration-pen-red/30 hover:decoration-pen-red underline-offset-4 cursor-pointer"
                        >
                            ← back to the table of contents
                        </a>
                        <span class="text-ink-soft/50" aria-hidden="true">·</span>
                        <a
                            href="/explore"
                            class="font-sketch text-base text-ink-soft hover:text-pen-red cursor-pointer"
                        >
                            open the binder →
                        </a>
                    </div>

                    <p class="font-sketch text-sm text-ink-soft/80 mt-6">
                        or press <kbd class="font-type text-[12px] bg-white border border-ink-dark/15 rounded px-1.5 py-0.5 mx-0.5">⌘K</kbd> and search — it works from anywhere.
                    </p>

                    <div
                        class="absolute bottom-4 right-6 -rotate-3 font-sketch text-base text-ink-soft/60 italic pointer-events-none"
                    >
                        — file not found —
                    </div>
                </div>
            </article>

            <aside class="space-y-8 lg:pt-10">
                <Sticky color="peach" rotate={2}>
                    <h3 class="font-title text-[26px] leading-tight text-ink-dark mb-1">where to look</h3>
                    <ul class="font-hand text-[16px] text-ink-dark/90 leading-tight space-y-1.5">
                        <li>· check the URL for a typo</li>
                        <li>·
                            press <CodeInline>⌘K</CodeInline> and search
                        </li>
                        <li>·
                            flip through the <a href="/explore" class="text-pen-red hover:underline cursor-pointer">binder</a>
                        </li>
                        <li>·
                            start over from <a href="/" class="text-pen-red hover:underline cursor-pointer">page one</a>
                        </li>
                    </ul>
                </Sticky>

                <Sticky color="mint" rotate={-1.5}>
                    <h3 class="font-title text-[24px] leading-tight text-ink-dark mb-1">trivia</h3>
                    <p class="font-hand text-[16px] text-ink-dark/90 leading-tight">
                        <Marker>404</Marker> isn't a fun number — it's the HTTP status for <span class="italic">"I looked. I didn't find."</span> The server is being specific so you know it wasn't your internet's fault.
                    </p>
                </Sticky>

                <Sticky color="yellow" rotate={1}>
                    <h3 class="font-title text-[22px] leading-tight text-ink-dark mb-1">if you wrote this yourself</h3>
                    <p class="font-hand text-[15px] text-ink-dark/90 leading-tight">
                        In Astro, this page lives at <CodeInline>src/pages/404.astro</CodeInline>. Add one to your own project and the host serves it whenever a URL doesn't match a real file.
                    </p>
                </Sticky>
            </aside>
        </div>
    </main>
</NotebookLayout>
