---
type Props = {
    label?: string;
    href?: string;
    color?: "red" | "ink";
    class?: string;
};

const { label = "Run it!", href, color = "red", class: cls = "" } = Astro.props;
const colorClass = color === "red" ? "text-pen-red stroke-pen-red" : "text-ink-dark stroke-ink-dark";
const hoverClass = color === "red" ? "group-hover:stroke-[3.5]" : "group-hover:stroke-pen-red group-hover:text-pen-red";
const Tag = href ? "a" : "button";
---

<Tag href={href} class:list={["group relative font-title text-[28px] leading-none cursor-pointer inline-block", colorClass, cls]}>
    <span class="relative z-10 px-7 py-2 inline-block">{label}</span>
    <svg
        viewBox="0 0 200 60"
        class:list={["absolute inset-0 w-full h-full fill-none transition-all", hoverClass]}
        stroke-width="2.6"
        stroke-linecap="round"
        stroke-linejoin="round"
        preserveAspectRatio="none"
    >
        <path d="M10 18 Q 4 8 18 6 L 180 4 Q 196 4 194 22 L 192 48 Q 196 58 178 56 L 22 56 Q 6 54 8 40 Z"></path>
    </svg>
</Tag>
