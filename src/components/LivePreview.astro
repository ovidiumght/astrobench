---
type Props = {
    cellId: string;
    rotate?: number;
    caption?: string;
    frameHeight?: number;
    class?: string;
};

const { cellId, rotate = 2.5, caption, frameHeight = 220, class: cls = "" } = Astro.props;

/*
 * Base CSS injected into the live preview iframe. Sets up readable typography
 * AND paper-themed scrollbars so any overflow inside the polaroid keeps the
 * notebook look. Kept as one compact string because srcdoc is space-sensitive.
 */
const previewBaseStyles =
    "html,body{margin:0;padding:14px 16px;font-family:system-ui,sans-serif;color:#1a1a2e;line-height:1.5;background:#fff;scrollbar-width:thin;scrollbar-color:rgba(200,69,69,0.35) transparent}" +
    "h1{font-size:32px;line-height:1.1;margin:0 0 8px}h2{font-size:24px;line-height:1.2;margin:0 0 6px}h3{font-size:20px;margin:0 0 4px}p{margin:0 0 10px}a{color:#0066cc}" +
    "::-webkit-scrollbar{width:10px;height:10px}" +
    "::-webkit-scrollbar-track{background:transparent}" +
    "::-webkit-scrollbar-thumb{background-color:rgba(200,69,69,0.35);border:2px solid transparent;border-radius:999px;background-clip:padding-box}" +
    "::-webkit-scrollbar-thumb:hover{background-color:rgba(200,69,69,0.65)}" +
    "::-webkit-scrollbar-thumb:active{background-color:#c84545}" +
    "::-webkit-scrollbar-corner{background:transparent}";
const previewSrcDoc = `<!doctype html><html><head><style>${previewBaseStyles}</style></head><body></body></html>`;
---

<div
    class:list={["relative bg-white shadow-polaroid border border-ink-dark/8 p-3 pb-12 max-w-[360px]", cls]}
    style={`transform:rotate(${rotate}deg)`}
    data-live-preview={cellId}
>
    <span
        class="absolute -top-4 left-1/2 -translate-x-1/2 w-28 h-7 bg-tape border-x border-tape-edge"
        style="transform:translateX(-50%) rotate(1deg); background-image: linear-gradient(110deg, transparent 0%, rgba(255,255,255,0.25) 50%, transparent 100%);"
    ></span>

    <div class="relative bg-paper-yellow border-2 border-paper-edge overflow-hidden">
        <iframe
            data-live-preview-frame
            sandbox="allow-same-origin"
            class="block w-full bg-white"
            style={`height:${frameHeight}px;border:0;`}
            srcdoc={previewSrcDoc}
        ></iframe>

        <div
            data-live-preview-error
            class="paper-scrollbar hidden absolute inset-0 bg-pen-red/10 border-2 border-pen-red border-dashed p-4 font-sketch text-pen-red text-base overflow-auto"
        >
        </div>
    </div>

    {
        caption && (
            <p class="absolute bottom-2.5 left-0 right-0 text-center font-title text-[22px] text-ink-soft -rotate-1">
                {caption}
            </p>
        )
    }
</div>

<script>
    import "~/scripts/live-cells";
</script>
