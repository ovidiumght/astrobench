---
/**
 * Global ⌘K command palette. Searches the union of every concept in the
 * binder and every lesson across both chapters. Rendered once inside
 * NotebookLayout so it's available from every page; opens with ⌘K / Ctrl+K,
 * closes with Esc or a backdrop click.
 *
 * No external dependencies — vanilla DOM with arrow-key navigation and
 * substring scoring done client-side.
 */
import { concepts, categoryMeta } from "~/lib/concepts";
import { chapters, lessonUrl } from "~/lib/lessons";

type Item = {
    type: "concept" | "lesson";
    id: string;
    title: string;
    subtitle: string;
    href: string;
    meta: string;
    metaDotClass: string;
    search: string;
};

const conceptItems: Item[] = concepts.map((c) => ({
    type: "concept",
    id: c.id,
    title: c.title,
    subtitle: c.blurb,
    href: `/explore#${c.id}`,
    meta: c.category,
    metaDotClass: categoryMeta[c.category].dot,
    search: [c.title, c.blurb, c.category, c.tags.join(" "), c.id].join(" ").toLowerCase(),
}));

const lessonItems: Item[] = chapters.flatMap((ch) =>
    ch.lessons.map((l) => ({
        type: "lesson" as const,
        id: l.slug,
        title: l.title,
        subtitle: l.subtitle,
        href: lessonUrl(l),
        meta: `Ch. ${ch.number} · L${l.step}`,
        metaDotClass: "bg-pen-red/60",
        search: [l.title, l.subtitle, l.concept, ch.name, `lesson ${l.step}`].join(" ").toLowerCase(),
    })),
);

const items: Item[] = [...conceptItems, ...lessonItems];
---

<div
    data-cmdk-root
    class="hidden fixed inset-0 z-50 px-4 pt-[12vh] pb-8"
    role="dialog"
    aria-modal="true"
    aria-label="Search astrobench"
>
    <div data-cmdk-backdrop class="absolute inset-0 bg-ink-dark/40 backdrop-blur-[2px]"></div>

    <div class="relative mx-auto max-w-[640px] bg-white border-2 border-ink-dark/15 rounded-lg shadow-paper overflow-hidden">
        <div class="flex items-center gap-3 px-4 py-3 border-b border-ink-dark/10 bg-paper-yellow/50">
            <span class="font-sketch text-lg text-pen-red leading-none">⌘K</span>
            <input
                data-cmdk-input
                type="text"
                placeholder="search concepts and lessons…"
                autocomplete="off"
                spellcheck="false"
                class="flex-1 font-type text-[16px] bg-transparent outline-none text-ink-dark placeholder:text-ink-soft/50"
            />
            <button
                type="button"
                data-cmdk-close
                aria-label="close"
                class="font-sketch text-sm text-ink-soft hover:text-pen-red cursor-pointer"
            >
                esc
            </button>
        </div>

        <ul
            data-cmdk-list
            class="max-h-[60vh] overflow-y-auto paper-scrollbar py-1"
            role="listbox"
        >
            {
                items.map((item, i) => (
                    <li
                        data-cmdk-item
                        data-href={item.href}
                        data-search={item.search}
                        data-index={i}
                        data-type={item.type}
                        role="option"
                        class="cmdk-item flex items-center gap-3 px-4 py-2.5 cursor-pointer border-l-2 border-transparent"
                    >
                        <span class:list={["inline-block h-2 w-2 rounded-full flex-none", item.metaDotClass]} />
                        <div class="min-w-0 flex-1">
                            <p class="font-sketch text-[15px] text-ink-dark truncate" data-cmdk-title>
                                {item.title}
                            </p>
                            <p class="font-sketch text-[12px] text-ink-soft/80 truncate" data-cmdk-subtitle>
                                {item.subtitle}
                            </p>
                        </div>
                        <span class="font-sketch text-[11px] text-ink-soft/70 uppercase tracking-wider whitespace-nowrap">
                            {item.meta}
                        </span>
                    </li>
                ))
            }
        </ul>

        <div
            data-cmdk-empty
            class="hidden px-4 py-6 text-center font-sketch text-sm text-ink-soft italic"
        >
            nothing's filed under that. try fewer letters.
        </div>

        <div class="px-4 py-2 border-t border-ink-dark/10 bg-paper-warm/40 flex items-center gap-3 font-sketch text-[11px] text-ink-soft/80">
            <span><kbd class="font-type bg-white border border-ink-dark/15 rounded px-1">↑↓</kbd> navigate</span>
            <span><kbd class="font-type bg-white border border-ink-dark/15 rounded px-1">↵</kbd> open</span>
            <span><kbd class="font-type bg-white border border-ink-dark/15 rounded px-1">esc</kbd> close</span>
            <span class="ml-auto">{items.length} entries</span>
        </div>
    </div>
</div>

<style>
    .cmdk-item:hover,
    .cmdk-item[data-active="true"] {
        background: rgba(254, 250, 224, 0.85);
        border-left-color: rgba(200, 69, 69, 0.7);
    }
    :global([data-cmdk-item] mark.cmdk-hl) {
        background: rgba(252, 211, 77, 0.55);
        color: inherit;
        padding: 0 1px;
        border-radius: 2px;
    }
</style>

<script>
    const root = document.querySelector<HTMLElement>("[data-cmdk-root]");
    const input = document.querySelector<HTMLInputElement>("[data-cmdk-input]");
    const list = document.querySelector<HTMLElement>("[data-cmdk-list]");
    const emptyEl = document.querySelector<HTMLElement>("[data-cmdk-empty]");
    const backdrop = document.querySelector<HTMLElement>("[data-cmdk-backdrop]");
    const closeBtn = document.querySelector<HTMLButtonElement>("[data-cmdk-close]");

    if (root && input && list && emptyEl && backdrop && closeBtn) {
        const items = Array.from(list.querySelectorAll<HTMLElement>("[data-cmdk-item]"));
        const titles = items.map((it) => it.querySelector<HTMLElement>("[data-cmdk-title]"));
        const subtitles = items.map((it) => it.querySelector<HTMLElement>("[data-cmdk-subtitle]"));
        const originalTitles = titles.map((el) => el?.textContent ?? "");
        const originalSubtitles = subtitles.map((el) => el?.textContent ?? "");

        let visibleIndices: number[] = items.map((_, i) => i);
        let active = 0;
        let isOpen = false;

        const esc = (s: string) =>
            s.replace(/[&<>"']/g, (c) =>
                c === "&" ? "&amp;" : c === "<" ? "&lt;" : c === ">" ? "&gt;" : c === '"' ? "&quot;" : "&#39;",
            );

        function highlight(text: string, q: string): string {
            if (!q) return esc(text);
            const lower = text.toLowerCase();
            const lq = q.toLowerCase();
            let out = "";
            let i = 0;
            while (i <= text.length) {
                const idx = lower.indexOf(lq, i);
                if (idx === -1) {
                    out += esc(text.slice(i));
                    break;
                }
                out += esc(text.slice(i, idx));
                out += `<mark class="cmdk-hl">${esc(text.slice(idx, idx + q.length))}</mark>`;
                i = idx + q.length;
            }
            return out;
        }

        function setActive(idx: number) {
            for (const item of items) item.removeAttribute("data-active");
            if (visibleIndices.length === 0) return;
            const safe = Math.max(0, Math.min(idx, visibleIndices.length - 1));
            active = safe;
            const el = items[visibleIndices[safe]];
            el.setAttribute("data-active", "true");
            el.scrollIntoView({ block: "nearest" });
        }

        function applyFilter() {
            const q = input!.value.trim().toLowerCase();
            visibleIndices = [];
            for (let i = 0; i < items.length; i++) {
                const item = items[i];
                const search = item.getAttribute("data-search") || "";
                const show = q === "" || search.includes(q);
                item.style.display = show ? "" : "none";
                if (show) visibleIndices.push(i);

                const tEl = titles[i];
                const sEl = subtitles[i];
                if (show && q) {
                    if (tEl) tEl.innerHTML = highlight(originalTitles[i], q);
                    if (sEl) sEl.innerHTML = highlight(originalSubtitles[i], q);
                } else {
                    if (tEl) tEl.textContent = originalTitles[i];
                    if (sEl) sEl.textContent = originalSubtitles[i];
                }
            }
            emptyEl!.classList.toggle("hidden", visibleIndices.length !== 0);
            setActive(0);
        }

        function open() {
            isOpen = true;
            root!.classList.remove("hidden");
            input!.value = "";
            applyFilter();
            requestAnimationFrame(() => input!.focus());
        }

        function close() {
            isOpen = false;
            root!.classList.add("hidden");
        }

        function navigate() {
            if (visibleIndices.length === 0) return;
            const el = items[visibleIndices[active]];
            const href = el.getAttribute("data-href");
            if (href) {
                close();
                window.location.href = href;
            }
        }

        /*
         * Global hotkey. Works from anywhere on the site because this script
         * is shipped via NotebookLayout. Captures both ⌘K (mac) and Ctrl+K
         * so muscle memory works on either OS.
         */
        document.addEventListener("keydown", (e) => {
            const k = e.key.toLowerCase();
            if ((e.metaKey || e.ctrlKey) && k === "k") {
                e.preventDefault();
                isOpen ? close() : open();
                return;
            }
            if (!isOpen) return;
            if (e.key === "Escape") {
                e.preventDefault();
                close();
                return;
            }
            if (e.key === "ArrowDown") {
                e.preventDefault();
                setActive(active + 1);
                return;
            }
            if (e.key === "ArrowUp") {
                e.preventDefault();
                setActive(active - 1);
                return;
            }
            if (e.key === "Enter") {
                e.preventDefault();
                navigate();
                return;
            }
        });

        input.addEventListener("input", applyFilter);

        backdrop.addEventListener("click", close);
        closeBtn.addEventListener("click", close);

        list.addEventListener("click", (e) => {
            const el = (e.target as HTMLElement | null)?.closest<HTMLElement>("[data-cmdk-item]");
            if (!el) return;
            const idxAttr = el.getAttribute("data-index");
            const idx = idxAttr ? Number(idxAttr) : -1;
            const visibleSlot = visibleIndices.indexOf(idx);
            if (visibleSlot >= 0) setActive(visibleSlot);
            navigate();
        });

        list.addEventListener("mousemove", (e) => {
            const el = (e.target as HTMLElement | null)?.closest<HTMLElement>("[data-cmdk-item]");
            if (!el) return;
            const idxAttr = el.getAttribute("data-index");
            const idx = idxAttr ? Number(idxAttr) : -1;
            const visibleSlot = visibleIndices.indexOf(idx);
            if (visibleSlot >= 0 && visibleSlot !== active) setActive(visibleSlot);
        });
    }
</script>
