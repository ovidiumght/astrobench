---
type Props = {
    file?: string;
    note?: string;
    code: string;
    highlightLine?: number;
    class?: string;
};

const { file = "index.astro", note, code, highlightLine, class: cls = "" } = Astro.props;
const lineCount = code.split("\n").length;
const lineArr = Array.from({ length: lineCount }, (_, i) => i + 1);
---

<div class:list={["relative my-10", cls]}>
    <span class="absolute -top-3 left-6 w-20 h-5 bg-tape border-x border-tape-edge -rotate-2 z-10 pointer-events-none"></span>
    <span class="absolute -top-3 right-12 w-20 h-5 bg-tape border-x border-tape-edge rotate-2 z-10 pointer-events-none"></span>

    <div class="relative bg-white border-2 border-ink-dark/12 shadow-code rounded-sm">
        <div class="flex items-center gap-2 border-b-2 border-dashed border-ink-dark/15 px-4 py-2 bg-paper-yellow/40">
            <span class="grid h-4 w-4 place-items-center font-sketch text-pen-red text-sm -rotate-[4deg]">✦</span>
            <span class="font-sketch text-base text-ink-soft">{file}</span>
            {note && <span class="font-sketch text-sm text-pen-red/80 italic">— {note}</span>}
            <span class="ml-auto font-sketch text-sm text-ink-soft/70 flex items-center gap-1.5" title="this snippet is for reading — the editable cells say ‘live’">
                <span class="inline-block h-2 w-2 rounded-full bg-ink-soft/40"></span>
                read-only
            </span>
        </div>

        <div class="flex font-type text-[14.5px] leading-[1.85] relative">
            <div class="select-none px-3 py-3 text-right text-ink-soft/50 border-r border-dashed border-ink-dark/12 shrink-0">
                {
                    lineArr.map((n) => (
                        <div class:list={[highlightLine === n && "text-pen-red font-bold"]}>{n}</div>
                    ))
                }
            </div>
            <pre class="paper-scrollbar flex-1 px-4 py-3 overflow-x-auto text-ink-navy m-0"><code set:html={code} /></pre>
        </div>
    </div>
</div>
